<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the Loan Reports portal.

  IIS serves none of this application. Every request is handed to Waitress on
  127.0.0.1:8600; this file exists only because IIS requires a physical path
  for a site, and that path is where it looks for web.config.

  IMPORTANT: the IIS site's physical path must be THIS FOLDER
  (C:\sites\LoanApk\iis), never the application folder above it. IIS cannot
  serve above its own site root, which is what keeps ../.env (database
  credentials, secret key), ../local.sqlite3 (password hashes) and ../logs
  (usernames and IP addresses) unreachable over HTTP. Point the site one level
  up and a single unmatched rewrite rule turns IIS into a file server over all
  of it.

  Requires, once per server:
    appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
    appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_HOST']" /commit:apphost
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          Let win-acme answer the ACME HTTP-01 challenge from disk.

          This MUST come first. The redirect below would send the Let's
          Encrypt validator to HTTPS, which does not exist yet the first time
          a certificate is issued - and the proxy rule would hand the
          challenge to Django, which knows nothing about it and would return
          404. Either way validation fails, and failed challenges count
          against Let's Encrypt rate limits.
        -->
        <rule name="AcmeChallenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>

        <!--
          Everything else over HTTPS. This runs before the proxy rule and
          stops processing, so the proxy only ever sees TLS traffic - which is
          what lets it assert X-Forwarded-Proto=https truthfully rather than
          hardcoding a claim that may be false. The payments-proxy config on
          this server omits this rule, which is why its sign-in page is
          reachable over plain HTTP while Django believes otherwise.
        -->
        <rule name="RedirectToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!--
          Hand everything to Waitress. X-Forwarded-Host matters because ARR
          replaces the Host header with the backend address - without it
          Django would think every request arrived for 127.0.0.1:8600 rather
          than the name the browser asked for, which breaks CSRF validation
          and produces redirect loops.

          Django only trusts these because Waitress is configured with
          trusted_proxy=127.0.0.1 and clear_untrusted_proxy_headers, so
          nothing off this machine can forge them.
        -->
        <rule name="ProxyToLoanReports" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8600/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- Django sets its own security headers; do not advertise the stack. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Excel exports of several hundred rows. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
