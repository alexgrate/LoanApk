# Copy to .env and fill in. .env is gitignored - never commit real credentials.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Read-only connection to the loan application database.
#
# Do NOT use the `postgres` superuser here. Create a dedicated read-only role:
#
#   CREATE ROLE loan_reader LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE dash_loans TO loan_reader;
#   GRANT USAGE ON SCHEMA public TO loan_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO loan_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO loan_reader;
#
# The last line matters: it covers tables added later, so a new loan product
# does not silently become invisible to this portal.
LOANS_DB_NAME=dash_loans
LOANS_DB_USER=loan_reader
LOANS_DB_PASSWORD=
LOANS_DB_HOST=127.0.0.1
LOANS_DB_PORT=5432

# Production only (ignored while DJANGO_DEBUG=True)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Exports and document downloads carry BVN, NIN, date of birth and next-of-kin
# details. Masked unless deliberately enabled.
EXPORT_INCLUDE_PII=False

# --- Email, via Microsoft Graph ----------------------------------------------
# Password setup and reset links are the only mail this app sends.
#
# Entra ID app registration needs the **Mail.Send** APPLICATION permission with
# admin consent. Note that grant is tenant-wide send-as: restrict it with an
# application access policy so this app can only send as GRAPH_SENDER.
#
# Leave these blank locally - messages are printed to the console instead.
# serve.py refuses to start without them when DJANGO_DEBUG=False, because
# otherwise reset links are silently never delivered.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=no-reply@dash-mfb.com
DEFAULT_FROM_EMAIL=Loan Reports <no-reply@dash-mfb.com>

# How long a setup or reset link stays valid, and how many links one address
# may request per hour.
PASSWORD_RESET_TIMEOUT_DAYS=3
PASSWORD_RESET_MAX_PER_HOUR=5

# Server binding. 8000-8002 and 8500 are taken by other apps on the VM.
DJANGO_BIND_HOST=0.0.0.0
DJANGO_PORT=8600
DJANGO_THREADS=8

# Reverse proxy that is allowed to set X-Forwarded-* headers.
DJANGO_TRUSTED_PROXY=127.0.0.1
